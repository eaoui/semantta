# Apache Jena Fuseki dataset
FUSEKI_DATASET_URL=http://localhost:3030/dataset_name

# HTTP request timeout for Fuseki operations, in seconds
FUSEKI_TIMEOUT=120

# Backend listener
SEMANTTA_HOST=127.0.0.1
SEMANTTA_PORT=8000

# Host header allowlist.
# Add the expected hostname when using a web deployment.
SEMANTTA_ALLOWED_HOSTS=127.0.0.1,localhost

# Trusted browser origins for CORS and state-changing API requests.
# For a web deployment, replace/add the actual frontend origin,
# including its scheme and port.
SEMANTTA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000