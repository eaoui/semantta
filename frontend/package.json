{
  "name": "semantta",
  "productName": "Semantta",
  "version": "0.1.0",
  "description": "Ontology-Based Linked Data Management System",
  "author": {
    "name": "Ehsan Rouhi",
    "email": "ehsanrouhi@live.com"
  },
  "homepage": "https://github.com/eaoui/semantta",
  "desktopName": "org.eaoui.semantta",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "electron": "electron .",
    "electron:generate": "node scripts/generate-electron.mjs",
    "electron:prepare-runtime": "python scripts/prepare_runtime.py",
    "electron:build-backend": "python ../backend/build_backend.py",
    "electron:package": "npm run electron:prepare-runtime && npm run electron:build-backend && npm run electron:generate && electron-builder --dir",
    "electron:smoke": "node ../scripts/smoke_test.mjs",
    "electron:dist": "npm run electron:prepare-runtime && npm run electron:build-backend && npm run electron:generate && electron-builder",
    "electron:dist:linux": "npm run electron:dist -- --linux",
    "electron:dist:linux:appimage": "npm run electron:dist -- --linux AppImage",
    "electron:dist:linux:deb": "npm run electron:dist -- --linux deb",
    "electron:dist:windows": "npm run electron:dist -- --win",
    "electron:dist:mac": "npm run electron:dist -- --mac",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "vis-network": "^10.1.0",
    "vue": "^3.5.39",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "nuxt-phosphor-icons": "^2.3.3",
    "tailwindcss": "^4.3.2"
  },
  "overrides": {
    "@nuxt/devtools": "4.0.0-beta.4"
  },
  "build": {
    "appId": "org.eaoui.semantta",
    "productName": "Semantta",
    "artifactName": "Semantta-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.svg",
    "asar": true,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "out"
    },
    "files": [
      "electron/**/*",
      ".output/public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "SemanttaBackend*"
        ]
      },
      {
        "from": "runtime/fuseki",
        "to": "runtime/fuseki"
      },
      {
        "from": "runtime/java",
        "to": "runtime/java"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Ehsan Rouhi <ehsanrouhi@live.com>",
      "description": "Ontology-Based Linked Data Management System",
      "executableName": "semantta",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Semantta",
          "Comment": "A web-based, RDF-native platform for managing linked data based on OWL/RDF ontologies.",
          "Categories": "Utility;",
          "Terminal": false,
          "Type": "Application"
        }
      }
    }
  }
}