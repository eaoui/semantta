{
  "name": "semantta-frontend",
  "type": "module",
  "version": "0.1.0",
  "description": "An Ontology-Based Linked Data Management System",
  "author": "Ehsan Rouhi",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "electron": "electron .",
    "electron:generate": "nuxt generate",
    "electron:prepare-runtime": "python scripts/prepare_runtime.py",
    "electron:build-backend": "python ../backend/build_backend.py",
    "electron:package": "npm run electron:prepare-runtime && npm run electron:build-backend && npm run electron:generate && electron-builder --dir",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "vis-network": "^10.1.0",
    "vue": "^3.5.39",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "nuxt-phosphor-icons": "^2.3.3",
    "tailwindcss": "^4.3.2"
  },
  "build": {
    "appId": "org.eaoui.semantta",
    "productName": "Semantta",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "electron/**/*",
      ".output/public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "SemanttaBackend*"
        ]
      },
      {
        "from": "runtime/fuseki",
        "to": "runtime/fuseki"
      },
      {
        "from": "runtime/java",
        "to": "runtime/java"
      }
    ]
  }
}